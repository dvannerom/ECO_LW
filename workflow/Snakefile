# One integrated DAG; settings and artifact names are defined once.
include: "settings.smk"

rule all:
    input:
        # Before K is reviewed, run the K-independent evidence and stop at the gate.
        *([] if SCENE_TAXONOMY_SELECTED else [SCENE_TAXONOMY_GATE]),
        ECO_SPECTRAL_METRICS,
        ECO_SPECTRAL_RESIDUALS,
        ABI_ADM_PROXY_SUMMARY,
        UNCERTAINTY_REGISTRY,
        UNCERTAINTY_GAP_REPORT,
        *UNCERTAINTY_FIGURES,
        *ECO_SPECTRAL_FIGURES,
        *SCENE_ID_OUTPUTS,
        *NARROWBAND_OUTPUTS,
        *ABI_PRODUCTION_OUTPUTS,
        SENS_REPORT,
        f"{SENS['figure_dir']}/broadband_sensitivity.png",
        f"{SENS['figure_dir']}/monthly_difference_maps.png",
        NOMINAL_BUDGET_REPORT,
        NOMINAL_PRODUCTS,
        BUDGET_CSV,
        NOMINAL_BUDGET_FIGURE,

rule check_scene_taxonomy:
    input:
        taxonomy=SCENE_TAXONOMY_FILE,
        diagnostics=SCENE_TAXONOMY["diagnostics"]["csv"],
        code=["scripts/check_scene_taxonomy.py", "src/scene_taxonomy.py"]
    output:
        SCENE_TAXONOMY_GATE
    params:
        settings=NOMINAL_SETTINGS_PATH
    shell:
        "python scripts/check_scene_taxonomy.py --taxonomy {input.taxonomy:q} "
        "--active-settings {params.settings:q} --output {output:q}"

