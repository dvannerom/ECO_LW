import json
from pathlib import Path


SELECTION_PATH = Path(config["selected_n_components_file"])
if SELECTION_PATH.exists():
    with SELECTION_PATH.open() as handle:
        selected_n_components = json.load(handle)["n_components"]
else:
    selected_n_components = config["scene_components"]

DAYS = [int(day) for day in config["days"]]
RESOLUTION = int(config["resolution_km"])
STEP = int(config["preprocess_step"])
SCENE_COMPONENTS = int(selected_n_components)
SELECTED_N_COMPONENTS_FILE = config["selected_n_components_file"]
TRAINING_FILES = config["training_files"]
MODEL = f"data/models/gmm_pipeline_merged_{len(TRAINING_FILES)}files_res{RESOLUTION}km_{SCENE_COMPONENTS}comp.joblib"
SUNNY_DIR = config["sunny_dir"]
GOES_FILTER_DIR = config["goes_filter_dir"]
NARROWBAND_TO_BROADBAND_COEFFS_FILE = config["narrowband_to_broadband_coeffs_file"]
CHANNEL_POWER_LAW_FILE = config["channel_power_law_file"]


def preprocessed(day):
    return f"data/preprocessed_files/abi_{day}_res{RESOLUTION}km_step{STEP}.nc"


def scene_id(day):
    return f"data/scene_id/scene_id_{day}_res{RESOLUTION}km_{SCENE_COMPONENTS}comp.nc"


def adm(day, channel, scene):
    return f"data/ADM/ADM_{day}_res{RESOLUTION}km_C{channel}_scene{scene}.nc"


def narrowband(day, channel):
    return f"data/narrowband_flux/narrowband_flux_{day}_res{RESOLUTION}km_C{channel}.nc"


def broadband(day):
    return f"data/broadband_flux/broadband_flux_{day}_res{RESOLUTION}km.nc"


BROADBAND_OUTPUTS = [broadband(day) for day in DAYS]


rule all:
    input:
        config["output"]["monthly"],
        MODEL,
        CHANNEL_POWER_LAW_FILE,
        NARROWBAND_TO_BROADBAND_COEFFS_FILE,
        *BROADBAND_OUTPUTS


rule train_scene_model:
    input:
        training=TRAINING_FILES,
        selection=SELECTED_N_COMPONENTS_FILE
    output:
        MODEL
    params:
        components=SCENE_COMPONENTS,
        n_components_file=SELECTED_N_COMPONENTS_FILE
    shell:
        "PYTHONPATH=src python scripts/train_GMM.py --input_file {input.training} --n_components {params.components} --n_components_file {params.n_components_file} --use_pca"


rule preprocess:
    output:
        "data/preprocessed_files/abi_{day}_res" + str(RESOLUTION) + "km_step" + str(STEP) + ".nc"
    params:
        step=STEP,
        resolution=RESOLUTION,
        lambda_center=float(config["lambda_center"])
    shell:
        "PYTHONPATH=src python scripts/preprocess_data_ABI.py --day {wildcards.day} "
        "--step {params.step} --res_km {params.resolution} "
        "--lambda_center {params.lambda_center}"


rule classify_scene:
    input:
        data=lambda wildcards: preprocessed(wildcards.day),
        model=MODEL
    output:
        "data/scene_id/scene_id_{day}_res" + str(RESOLUTION) + "km_" + str(SCENE_COMPONENTS) + "comp.nc"
    params:
        lambda_center=float(config["lambda_center"])
    shell:
        "PYTHONPATH=src python scripts/scene_id_pca.py --input_file {input.data} "
        "--model {input.model} --lambda_center {params.lambda_center} --no-plot"


rule fit_adm:
    input:
        data=lambda wildcards: preprocessed(wildcards.day),
        scene=lambda wildcards: scene_id(wildcards.day)
    output:
        adms=expand(
            "data/ADM/ADM_{{day}}_res" + str(RESOLUTION) + "km_C{channel}_scene{scene}.nc",
            channel=range(6),
            scene=range(SCENE_COMPONENTS),
        )
    params:
        resolution=RESOLUTION,
        n_components=SCENE_COMPONENTS
    shell:
        "mkdir -p data/.workflow && "
        "PYTHONPATH=src python scripts/fit_ADM.py --day {wildcards.day} "
        "--resolution {params.resolution} --n-components {params.n_components} "
        "--no-plot && "
        "touch data/.workflow/adm_{wildcards.day}_complete"


rule radiance_to_flux:
    input:
        data=lambda wildcards: preprocessed(wildcards.day),
        scene=lambda wildcards: scene_id(wildcards.day),
        adm=expand(
            "data/ADM/ADM_{{day}}_res" + str(RESOLUTION) + "km_C{channel}_scene{scene}.nc",
            channel=range(6),
            scene=range(SCENE_COMPONENTS),
        )
    output:
        narrowbands=expand(
            "data/narrowband_flux/narrowband_flux_{{day}}_res" + str(RESOLUTION) + "km_C{channel}.nc",
            channel=range(6),
        )
    params:
        resolution=RESOLUTION,
        n_components=SCENE_COMPONENTS,
        lambda_center=float(config["lambda_center"])
    shell:
        "mkdir -p data/.workflow && "
        "PYTHONPATH=src python scripts/radiance_to_flux.py --day {wildcards.day} "
        "--resolution {params.resolution} --n-components {params.n_components} "
        "--lambda_center {params.lambda_center} && "
        "touch data/.workflow/radiance_to_flux_{wildcards.day}_complete"


rule fit_channel_power_law:
    input:
        filters=GOES_FILTER_DIR
    output:
        CHANNEL_POWER_LAW_FILE
    params:
        filter_dir=GOES_FILTER_DIR
    shell:
        "PYTHONPATH=src python scripts/fit_irradiance.py "
        "--filter-dir {params.filter_dir} --output {output} --no-plot"


rule fit_narrowband_to_broadband_coeffs:
    input:
        sunny=SUNNY_DIR,
        filters=GOES_FILTER_DIR,
        power_law=CHANNEL_POWER_LAW_FILE
    output:
        NARROWBAND_TO_BROADBAND_COEFFS_FILE
    params:
        sunny_dir=SUNNY_DIR,
        filter_dir=GOES_FILTER_DIR
    shell:
        "PYTHONPATH=src python scripts/compute_temperature_SBDART.py "
        "--sunny-dir {params.sunny_dir} --filter-dir {params.filter_dir} "
        "--power-law-file {input.power_law} --output {output} --no-plot"


rule narrowband_to_broadband:
    input:
        data=lambda wildcards: preprocessed(wildcards.day),
        narrowbands=expand(
            "data/narrowband_flux/narrowband_flux_{{day}}_res" + str(RESOLUTION) + "km_C{channel}.nc",
            channel=range(6),
        ),
        coefficients=NARROWBAND_TO_BROADBAND_COEFFS_FILE
    output:
        "data/broadband_flux/broadband_flux_{day}_res" + str(RESOLUTION) + "km.nc"
    params:
        resolution=RESOLUTION,
        lambda_center=float(config["lambda_center"])
    shell:
        "PYTHONPATH=src python scripts/narrowband_to_broadband.py --day {wildcards.day} "
        "--resolution {params.resolution} --lambda_center {params.lambda_center} "
        "--coefficients-file {input.coefficients}"


rule monthly_flux:
    input:
        broadband=BROADBAND_OUTPUTS,
        reference=lambda wildcards: preprocessed(DAYS[0])
    output:
        config["output"]["monthly"]
    params:
        resolution=RESOLUTION,
        lambda_center=float(config["lambda_center"])
    shell:
        "PYTHONPATH=src python scripts/monthly_flux.py --inputs {input.broadband} "
        "--reference-data {input.reference} --output {output} "
        "--resolution {params.resolution} --lambda-center {params.lambda_center} --no-plot"
